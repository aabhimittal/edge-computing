#!/usr/bin/env ruby
# frozen_string_literal: true

# Ingests EdgeSuite frames from a chosen transport, prints per-anomaly alerts,
# optionally persists statistics, and emits a per-channel summary on exit.
#
#   # default: hex frames on stdin (an EdgeNode over Serial, or edge-sim)
#   ruby bin/edge-sim | ruby bin/edge-gateway
#
#   # a real serial port
#   ruby bin/edge-gateway --serial /dev/ttyUSB0 --baud 115200
#
#   # a raw binary stream: no hex, no line boundaries, resynced on the fly
#   ruby bin/edge-gateway --raw /dev/ttyUSB0
#   ruby bin/edge-gateway --raw capture.bin
#
#   # an MQTT broker (needs the 'mqtt' gem); LoRa/Wi-Fi fleets fan in here
#   ruby bin/edge-gateway --mqtt broker.local --topic 'edge/+/frames'
#
#   # persist snapshots + anomaly log to a directory (survives restarts)
#   ruby bin/edge-gateway --serial /dev/ttyUSB0 --persist ./stats

require_relative "../lib/edge_suite"

opts = { snapshot_every: 50 }
args = ARGV.dup
until args.empty?
  case (flag = args.shift)
  when "--serial"  then opts[:serial] = args.shift
  when "--baud"    then opts[:baud] = args.shift.to_i
  when "--raw"     then opts[:raw] = args.shift
  when "--mqtt"    then opts[:mqtt] = args.shift
  when "--topic"   then opts[:topic] = args.shift
  when "--port"    then opts[:port] = args.shift.to_i
  when "--persist" then opts[:persist] = args.shift
  when "--snapshot-every" then opts[:snapshot_every] = args.shift.to_i
  when "-h", "--help"
    puts <<~USAGE
      usage: edge-gateway [source] [--persist DIR] [--snapshot-every N]
        (default source)          hex frames from stdin
        --serial DEV [--baud N]   a serial port (newline-delimited hex)
        --raw DEV|FILE            a raw binary stream or capture file
        --mqtt HOST [--port N] [--topic T]   an MQTT broker
    USAGE
    exit 0
  else
    warn "unknown flag: #{flag}"; exit 1
  end
end

transport = EdgeSuite::Transport.build(opts)
store = opts[:persist] ? EdgeSuite::StatsStore.new(dir: opts[:persist]) : nil
runner = EdgeSuite::GatewayRunner.new(store: store, snapshot_every: opts[:snapshot_every])

# Resume note: report what was already on disk before this run.
if store && (snap = store.load_snapshot)
  warn "resuming: previous snapshot from #{snap[:updated_at]}, " \
       "#{store.anomaly_count} anomalies already logged"
end

runner.run(transport) do |ch, idx, value, score|
  warn format("! anomaly  ch=%d  idx=%-4d  value=%-6d  z=%+.2f", ch, idx, value, score)
end

puts "\n=== Gateway summary ==="
runner.gateway.report.each do |r|
  next if r.nil?

  puts format(
    "ch %d: %d frames, %d samples, %d B on wire vs %d B raw (%.1f%% saved), %d anomalies",
    r[:channel], r[:frames], r[:samples], r[:bytes_on_wire],
    r[:bytes_uncompressed], r[:bandwidth_saved_pct], r[:anomalies]
  )
  puts "        advice: #{r[:recommendation]}"
end

# Link quality, when the transport carved frames out of a raw byte stream:
# dropped bytes and CRC errors are the early warning a bandwidth report cannot
# give — they climb long before frames stop arriving.
if transport.respond_to?(:stats)
  st = transport.stats
  puts format("\nlink: %d frames, %d B dropped, %d CRC errors, %d resyncs",
              st[:frames], st[:dropped_bytes], st[:crc_errors], st[:resyncs])
end

# Nodes that went quiet during the run: a dead sensor and a calm one look
# identical in the numbers above, and only this tells them apart.
late = runner.gateway.silent_channels
unless late.empty?
  puts "\nliveness:"
  late.each do |h|
    puts format("  ch %d: %s (%.1fs since last frame, expected every %d ms)",
                h[:channel], h[:status], h[:silent_for], h[:expected_interval_ms])
  end
end

if store
  store.close
  puts "\npersisted to #{store.dir}/ (snapshot.json, anomalies.jsonl)"
end
